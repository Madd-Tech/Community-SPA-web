---
import logo from "../assets/image/logo.png";
---

<nav class="bg-gray-900 text-white shadow-lg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a
          href="/node_modules/"
          class="text-2xl font-bold bg-gradient-to-r from-blue-400 to-purple-600 bg-clip-text text-transparent"
        >
         <img  src={logo.src}
        width="150"
        height="80"
        alt="Cart Logo"
        class="transition duration-300 hover:drop-shadow-[0_0_10px_#D64218] hover:brightness-125">
        </a>
      </div>

      <!-- Desktop Menu -->
      <div class="hidden md:block">
        <div class="ml-10 flex items-center space-x-8">
          <a
            href="#home"
            class="hover:text-blue-400 transition-colors duration-300">Home</a
          >
          <a
            href="#about"
            class="hover:text-blue-400 transition-colors duration-300">About</a
          >
          <a
            href="#projects"
            class="hover:text-blue-400 transition-colors duration-300"
            >Projects</a
          >
          <a
            href="#contact"
            class="hover:text-blue-400 transition-colors duration-300"
            >Contact</a
          >
        </div>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button
          id="mobile-menu-button"
          class="inline-flex items-center justify-center p-2 rounded-md hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-500 transition-colors duration-300"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <!-- Hamburger icon -->
          <svg
            id="menu-open-icon"
            class="block h-6 w-6"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <!-- Close icon -->
          <svg
            id="menu-close-icon"
            class="hidden h-6 w-6"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu, hidden by default -->
  <div id="mobile-menu" class="hidden md:hidden">
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 bg-gray-800">
      <a
        href="#home"
        class="block px-3 py-2 rounded-md hover:bg-gray-700 transition-colors duration-300"
        >Home</a
      >
      <a
        href="#about"
        class="block px-3 py-2 rounded-md hover:bg-gray-700 transition-colors duration-300"
        >About</a
      >
      <a
        href="#projects"
        class="block px-3 py-2 rounded-md hover:bg-gray-700 transition-colors duration-300"
        >Projects</a
      >
      <a
        href="#contact"
        class="block px-3 py-2 rounded-md hover:bg-gray-700 transition-colors duration-300"
        >Contact</a
      >
    </div>
  </div>
</nav>

<script>
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuOpenIcon = document.getElementById("menu-open-icon");
  const menuCloseIcon = document.getElementById("menu-close-icon");

  mobileMenuButton?.addEventListener("click", () => {
    const isHidden = mobileMenu?.classList.contains("hidden");

    if (isHidden) {
      mobileMenu?.classList.remove("hidden");
      menuOpenIcon?.classList.add("hidden");
      menuCloseIcon?.classList.remove("hidden");
    } else {
      mobileMenu?.classList.add("hidden");
      menuOpenIcon?.classList.remove("hidden");
      menuCloseIcon?.classList.add("hidden");
    }
  });

  const mobileMenuLinks = document.querySelectorAll("#mobile-menu a");
  mobileMenuLinks.forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
      menuOpenIcon?.classList.remove("hidden");
      menuCloseIcon?.classList.add("hidden");
    });
  });
</script>
